generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String       @id
  name          String
  email         String       @unique
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  sessions      Session[]
  accounts      Account[]
  memberships   Member[]
  invitations   Invitation[] @relation("InvitationInviter")
  blockedIps    BlockedIP[]   @relation("BlockedBy")
  auditLogs     AuditLog[]    @relation("AuditActor")

  @@map("admin_users")
}

model Session {
  id                   String   @id
  token                String   @unique
  expiresAt            DateTime
  ipAddress            String?
  userAgent            String?
  activeOrganizationId String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([activeOrganizationId])
  @@map("admin_sessions")
}

model Account {
  id                    String    @id
  issuer                String
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@unique([issuer, accountId])
  @@map("admin_accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("auth_verifications")
}

model Organization {
  id          String       @id
  name        String
  slug        String       @unique
  logo        String?
  metadata    String?
  createdAt   DateTime     @default(now())
  members     Member[]
  invitations Invitation[]
  sites       Site[]
  blockedIps  BlockedIP[]
  auditLogs   AuditLog[]

  @@map("organizations")
}

model Member {
  id             String       @id
  organizationId String
  userId         String
  role           String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId, role])
  @@map("organization_members")
}

model Invitation {
  id             String       @id
  organizationId String
  email          String
  role           String?
  status         String
  expiresAt      DateTime
  inviterId      String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter        User         @relation("InvitationInviter", fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("organization_invitations")
}

enum SiteEnvironment {
  PRODUCTION
  STAGING
  DEVELOPMENT
}

enum SiteStatus {
  DRAFT
  PENDING_VERIFICATION
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum SecurityMode {
  MONITOR_ONLY
  MONITOR_AND_ENFORCE
}

enum ExternalUserStatus {
  ACTIVE
  SUSPICIOUS
  BLOCKED
}

enum SiteSessionStatus {
  ACTIVE
  IDLE
  INACTIVE
  EXPIRED
  REVOKED
  LOGGED_OUT
}

enum DeviceStatus {
  KNOWN
  NEW
  SUSPICIOUS
  REVOKED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum SecurityEventStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  DISMISSED
}

enum BlockedIPScope {
  GLOBAL
  SITE
}

enum BlockedIPStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

model Site {
  id                 String          @id @default(cuid())
  organizationId     String
  name               String
  slug               String
  domain             String
  environment        SiteEnvironment
  status             SiteStatus      @default(DRAFT)
  securityMode       SecurityMode     @default(MONITOR_ONLY)
  retentionDays      Int              @default(90)
  verifiedAt         DateTime?
  lastEventAt        DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  deletedAt          DateTime?
  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  credentials        SiteApiCredential[]
  externalUsers      ExternalUser[]
  sessions           SiteSession[]
  devices            Device[]
  loginAttempts      LoginAttempt[]
  securityEvents     SecurityEvent[]
  blockedIps         BlockedIP[]
  auditLogs          AuditLog[]

  @@unique([organizationId, slug])
  @@unique([organizationId, domain, environment])
  @@unique([organizationId, id])
  @@index([organizationId, status])
  @@index([organizationId, deletedAt])
  @@index([status])
  @@index([lastEventAt])
  @@index([createdAt])
  @@map("sites")
}

model SiteApiCredential {
  id             String          @id @default(cuid())
  organizationId String
  siteId         String
  name           String
  keyPrefix      String
  secretHash     String
  environment    SiteEnvironment
  createdAt      DateTime        @default(now())
  lastUsedAt     DateTime?
  expiresAt      DateTime?
  revokedAt      DateTime?
  site           Site            @relation(fields: [organizationId, siteId], references: [organizationId, id], onDelete: Cascade)
  rateLimits     CollectorRateLimit[]

  @@unique([organizationId, keyPrefix])
  @@unique([secretHash])
  @@index([organizationId, siteId])
  @@index([siteId, revokedAt])
  @@index([createdAt])
  @@map("site_api_credentials")
}

model CollectorRateLimit {
  credentialId String
  windowStart  DateTime
  count        Int               @default(0)
  expiresAt    DateTime
  credential  SiteApiCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  @@id([credentialId, windowStart])
  @@index([expiresAt])
  @@map("collector_rate_limits")
}

model ExternalUser {
  id             String             @id @default(cuid())
  organizationId String
  siteId         String
  externalUserId String
  email          String?
  displayName    String?
  status         ExternalUserStatus @default(ACTIVE)
  riskScore      Int                @default(0)
  riskLevel      RiskLevel          @default(LOW)
  firstSeenAt    DateTime           @default(now())
  lastSeenAt     DateTime           @default(now())
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  site           Site               @relation(fields: [organizationId, siteId], references: [organizationId, id], onDelete: Cascade)
  sessions       SiteSession[]
  devices        Device[]
  loginAttempts  LoginAttempt[]
  securityEvents SecurityEvent[]

  @@unique([siteId, externalUserId])
  @@unique([organizationId, siteId, id])
  @@index([organizationId, siteId])
  @@index([externalUserId])
  @@index([status])
  @@index([lastSeenAt])
  @@map("external_users")
}

model SiteSession {
  id                   String            @id @default(cuid())
  organizationId       String
  siteId               String
  externalSessionId    String
  externalUserRecordId String?
  deviceId             String?
  status               SiteSessionStatus @default(ACTIVE)
  ipAddress            String?
  userAgent            String?
  country              String?
  region               String?
  city                 String?
  timezone             String?
  asn                  String?
  isp                  String?
  riskScore            Int               @default(0)
  riskLevel            RiskLevel         @default(LOW)
  startedAt            DateTime
  lastActiveAt         DateTime
  expiresAt            DateTime?
  logoutAt             DateTime?
  revokedAt            DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  site                 Site              @relation(fields: [organizationId, siteId], references: [organizationId, id], onDelete: Cascade)
  externalUser         ExternalUser?     @relation(fields: [organizationId, siteId, externalUserRecordId], references: [organizationId, siteId, id], onDelete: Restrict)
  device               Device?           @relation(fields: [organizationId, siteId, deviceId], references: [organizationId, siteId, id], onDelete: Restrict)
  securityEvents       SecurityEvent[]

  @@unique([siteId, externalSessionId])
  @@unique([organizationId, siteId, id])
  @@index([organizationId, siteId])
  @@index([externalUserRecordId])
  @@index([deviceId])
  @@index([ipAddress])
  @@index([status, lastActiveAt])
  @@index([createdAt])
  @@map("site_sessions")
}

model Device {
  id                   String       @id @default(cuid())
  organizationId       String
  siteId               String
  externalUserRecordId String?
  deviceKey            String
  friendlyName         String
  type                 String
  vendor               String?
  model                String?
  browser              String
  browserVersion       String?
  os                   String
  osVersion            String?
  status               DeviceStatus @default(NEW)
  firstSeenAt          DateTime     @default(now())
  lastSeenAt           DateTime     @default(now())
  lastIpAddress        String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  site                 Site         @relation(fields: [organizationId, siteId], references: [organizationId, id], onDelete: Cascade)
  externalUser         ExternalUser? @relation(fields: [organizationId, siteId, externalUserRecordId], references: [organizationId, siteId, id], onDelete: Restrict)
  sessions             SiteSession[]
  loginAttempts        LoginAttempt[]
  securityEvents       SecurityEvent[]

  @@unique([siteId, deviceKey])
  @@unique([organizationId, siteId, id])
  @@index([organizationId, siteId])
  @@index([externalUserRecordId])
  @@index([lastIpAddress])
  @@index([status])
  @@index([lastSeenAt])
  @@map("devices")
}

model LoginAttempt {
  id                   String    @id @default(cuid())
  organizationId       String
  siteId               String
  eventId              String?
  externalUserRecordId String?
  deviceId             String?
  externalUserId       String?
  success              Boolean
  failureReason        String?
  ipAddress            String?
  userAgent            String?
  country              String?
  region               String?
  city                 String?
  riskScore            Int       @default(0)
  riskLevel            RiskLevel @default(LOW)
  occurredAt           DateTime
  createdAt            DateTime  @default(now())
  site                 Site      @relation(fields: [organizationId, siteId], references: [organizationId, id], onDelete: Cascade)
  externalUser         ExternalUser? @relation(fields: [organizationId, siteId, externalUserRecordId], references: [organizationId, siteId, id], onDelete: Restrict)
  device               Device?   @relation(fields: [organizationId, siteId, deviceId], references: [organizationId, siteId, id], onDelete: Restrict)

  @@unique([siteId, eventId])
  @@index([organizationId, siteId])
  @@index([externalUserId])
  @@index([externalUserRecordId])
  @@index([deviceId])
  @@index([ipAddress])
  @@index([success, occurredAt])
  @@index([riskLevel])
  @@index([createdAt])
  @@map("login_attempts")
}

model SecurityEvent {
  id                   String              @id @default(cuid())
  organizationId       String
  siteId               String
  eventId              String
  eventType            String
  externalUserId       String?
  externalSessionId    String?
  externalUserRecordId String?
  siteSessionId        String?
  deviceId             String?
  ipAddress            String?
  metadata             Json?
  riskScore            Int                 @default(0)
  riskLevel            RiskLevel           @default(LOW)
  riskReasons          Json?
  status               SecurityEventStatus @default(OPEN)
  occurredAt           DateTime
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  site                 Site                @relation(fields: [organizationId, siteId], references: [organizationId, id], onDelete: Cascade)
  externalUser         ExternalUser?       @relation(fields: [organizationId, siteId, externalUserRecordId], references: [organizationId, siteId, id], onDelete: Restrict)
  session              SiteSession?        @relation(fields: [organizationId, siteId, siteSessionId], references: [organizationId, siteId, id], onDelete: Restrict)
  device               Device?             @relation(fields: [organizationId, siteId, deviceId], references: [organizationId, siteId, id], onDelete: Restrict)

  @@unique([siteId, eventId])
  @@index([organizationId, siteId])
  @@index([externalUserId])
  @@index([externalUserRecordId])
  @@index([externalSessionId])
  @@index([siteSessionId])
  @@index([deviceId])
  @@index([ipAddress])
  @@index([eventType, occurredAt])
  @@index([riskLevel, status])
  @@index([createdAt])
  @@map("security_events")
}

model BlockedIP {
  id             String          @id @default(cuid())
  organizationId String
  siteId         String?
  ipAddress      String
  scope          BlockedIPScope
  reason         String
  enforcement    SecurityMode    @default(MONITOR_ONLY)
  status         BlockedIPStatus @default(ACTIVE)
  blockedById    String?
  expiresAt      DateTime?
  revokedAt      DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site           Site?           @relation(fields: [organizationId, siteId], references: [organizationId, id], onDelete: Cascade)
  blockedBy      User?           @relation("BlockedBy", fields: [blockedById], references: [id], onDelete: SetNull)

  @@index([organizationId, siteId])
  @@index([ipAddress])
  @@index([scope, status])
  @@index([status, expiresAt])
  @@index([createdAt])
  @@map("blocked_ips")
}

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  siteId         String?
  actorId        String?
  action         String
  targetType     String
  targetId       String?
  metadata       Json?
  actorIp        String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site           Site?        @relation(fields: [organizationId, siteId], references: [organizationId, id], onDelete: Restrict)
  actor          User?        @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, siteId])
  @@index([actorId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([actorIp])
  @@index([createdAt])
  @@map("audit_logs")
}
