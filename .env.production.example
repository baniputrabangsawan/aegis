DEPLOY_ENV_FILE=.env.production
NODE_ENV=production
DASHBOARD_DOMAIN=security.example.com
ACME_EMAIL=ops@example.com
POSTGRES_USER=aegis
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
POSTGRES_DB=aegis_control
DATABASE_URL=postgresql://aegis:replace-with-a-long-random-database-password@postgres:5432/aegis_control?schema=public&sslmode=disable
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=10000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=https://security.example.com
TRUSTED_ORIGINS=https://security.example.com
APP_NAME=Aegis Control
ALLOW_ADMIN_SIGNUP=false
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=30
