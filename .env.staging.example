DEPLOY_ENV_FILE=.env.staging
NODE_ENV=production
DASHBOARD_DOMAIN=staging-security.example.com
ACME_EMAIL=ops@example.com
POSTGRES_USER=aegis_staging
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
POSTGRES_DB=aegis_control_staging
DATABASE_URL=postgresql://aegis_staging:replace-with-a-long-random-database-password@postgres:5432/aegis_control_staging?schema=public&sslmode=disable
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=10000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=https://staging-security.example.com
TRUSTED_ORIGINS=https://staging-security.example.com
APP_NAME=Aegis Control Staging
ALLOW_ADMIN_SIGNUP=false
COLLECTOR_RATE_LIMIT_PER_MINUTE=120
COLLECTOR_SINGLE_MAX_BYTES=65536
COLLECTOR_BATCH_MAX_BYTES=524288
COLLECTOR_TRUSTED_PROXIES=
COLLECTOR_PROXY_SECRET=replace-with-at-least-32-random-characters
GEOIP_IPINFO_TOKEN=
GEOIP_CACHE_TTL_HOURS=168
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
