# PostgreSQL connection string. Use a dedicated database per environment.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aegis_control?schema=public"
DB_POOL_MAX="10"
DB_IDLE_TIMEOUT_MS="30000"
DB_CONNECTION_TIMEOUT_MS="10000"

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
BETTER_AUTH_URL="http://localhost:3000"

# Comma-separated, exact origins only. Do not use * in production.
TRUSTED_ORIGINS="http://localhost:3000"

APP_NAME="Aegis Control"

# Enable briefly only when bootstrapping the first administrator.
ALLOW_ADMIN_SIGNUP="false"

# Collector protection. Batch requests consume one unit per event.
COLLECTOR_RATE_LIMIT_PER_MINUTE="120"
COLLECTOR_SINGLE_MAX_BYTES="65536"
COLLECTOR_BATCH_MAX_BYTES="524288"
COLLECTOR_TRUSTED_PROXIES=""
# Shared only by the reverse proxy and app. Generate with: openssl rand -hex 32
COLLECTOR_PROXY_SECRET=""

# Optional GeoIP provider. Leave empty to disable IP geolocation enrichment.
GEOIP_IPINFO_TOKEN=""
GEOIP_CACHE_TTL_HOURS="168"
